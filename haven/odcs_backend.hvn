    {"platform": "transpiler", "target": "haven_lang.py", "label": "Haven v2.0 Natural-English CLI (.py)", "category": "Web", "size": "27.7 KB", "sha256": "dd3236cf0d2e1bfc39469f3dfdf60714d5cfabc82c8e359cee5a5f25c61dd0ab"},
    {"platform": "linux", "target": "haven-1.0.0-linux-x86_64.tar.gz", "label": "Haven Linux x86_64 Tarball (.tar.gz)", "category": "Linux", "size": "72.8 KB", "sha256": "8cf6a540bffb6e895a6e05d718c65d0644b0492a75f2a46fea6d11f89bf82a01"},
    {"platform": "appimage", "target": "haven-1.0.0-x86_64.AppImage", "label": "Haven Linux Universal AppImage", "category": "Linux", "size": "72.6 KB", "sha256": "316f3d0cc901b4512db0ae0a9fe0023755d585e98df660b31e12f544639d4323"},
